/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Gated documents. Crawlers may still fetch these — that is deliberate, because a
# crawler that cannot fetch the file never sees the noindex and never drops the
# URL it already has. Do not add a robots.txt Disallow for /docs/ until Search
# Console confirms both PDFs are out of the index.
/docs/*
  Cache-Control: public, max-age=31536000, immutable
  X-Robots-Tag: noindex, nofollow

# Gated documents, delivered only through /api/doc with a signed, expiring link.
# Nothing links here, nothing indexes it, and no crawler is allowed in. Unlike
# /docs/, none of this is already in the index, so a hard block costs nothing.
/docs/private/*
  Cache-Control: private, no-store
  X-Robots-Tag: noindex, nofollow, noarchive

# Utility pages. Not for the index, but crawlable so the directive is seen.
/og.html
  X-Robots-Tag: noindex, nofollow

/thanks
  X-Robots-Tag: noindex, nofollow

# Images never change content at a given filename — safe to cache hard.
/assets/plates/*
  Cache-Control: public, max-age=31536000, immutable

/assets/brand/*
  Cache-Control: public, max-age=604800

# The stylesheet and scripts DO change content at the same filename.
# Caching these as immutable is how a deployed change fails to appear.
/assets/site.css
  Cache-Control: public, max-age=0, must-revalidate

/assets/nav.js
  Cache-Control: public, max-age=0, must-revalidate

/assets/consent.js
  Cache-Control: public, max-age=0, must-revalidate

/favicon.ico
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=86400
